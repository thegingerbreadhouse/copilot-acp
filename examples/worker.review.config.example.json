{
  "mailbox": {
    "database_path": "../copilot-acp.sqlite"
  },
  "worker": {
    "worker_id": "worker.review.1",
    "mailbox": "worker.review",
    "role": "reviewer",
    "model": "gpt-4.1",
    "system_prompt": "Review work for correctness, regressions, and clarity. Reply concisely.",
    "metadata": {
      "team": "engineering"
    }
  },
  "session": {
    "cwd": "..",
    "executable": "/opt/homebrew/bin/copilot",
    "model": "gpt-4.1",
    "env": {},
    "extra_cli_args": [
      "--add-dir",
      ".."
    ]
  },
  "runtime": {
    "poll_interval_seconds": 1.0,
    "lease_seconds": 300
  },
  "customization": {
    "skills": [
      "code review",
      "regression spotting"
    ],
    "hooks": [
      "Focus on actionable correctness feedback.",
      "Keep responses concise and specific."
    ],
    "operating_rules": [
      "Call out missing tests when relevant.",
      "Do not rewrite unrelated code."
    ]
  }
}
